# Supabase 대시보드 > Project Settings > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# anon / public key (신규 프로젝트는 sb_publishable_... 형태의 publishable key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 배포 주소 — 사이트맵·canonical에 쓰는 절대 URL의 기준
# Vercel은 VERCEL_PROJECT_PRODUCTION_URL을 자동으로 넣어주므로 생략해도 된다.
# 직접 산 도메인을 연결했다면 그 주소를 적는다.
NEXT_PUBLIC_SITE_URL=https://gotgan.vercel.app

# Google Search Console > 소유권 확인 > HTML 태그가 준 content 값 (DNS 확인을 쓰면 비워도 된다)
GOOGLE_SITE_VERIFICATION=
