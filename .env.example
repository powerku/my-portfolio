# Supabase 대시보드 > Project Settings > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# anon / public key (신규 프로젝트는 sb_publishable_... 형태의 publishable key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 배포 주소 — 사이트맵·canonical, 그리고 로그인 링크가 돌아올 주소의 기준
#
# 배포처(Vercel 환경 변수)에만 연결한 도메인을 적는다. 프리뷰 배포에서 로그인해도
# 항상 이 주소로 착지한다.
#   NEXT_PUBLIC_SITE_URL=https://myasset.cash
#
# 로컬 .env.local에서는 비워 둔다. 값이 없으면 지금 열어둔 주소(http://localhost:3000)로
# 돌아오므로, 로컬에서 받은 로그인 링크가 배포 주소로 새지 않는다.
NEXT_PUBLIC_SITE_URL=

# Google Search Console > 소유권 확인 > HTML 태그가 준 content 값 (DNS 확인을 쓰면 비워도 된다)
GOOGLE_SITE_VERIFICATION=
